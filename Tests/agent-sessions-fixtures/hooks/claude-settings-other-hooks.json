{
  "hooks": {
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "afplay /System/Library/Sounds/Glass.aiff"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "echo \"checked\" >> /tmp/hook.log",
            "timeout": 5.0
          }
        ]
      }
    ]
  },
  "model": "opus",
  "cleanupPeriodDays": 30.0
}
